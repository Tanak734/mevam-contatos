# ==============================================================
# PROJETO: MEVAM CONTATOS
# ==============================================================
PROJECT_NAME=mevam-contatos
NODE_ENV=development

# --------------------------------------------------------------
# DOCKER & BANCO DE DADOS (POSTGRESQL)
# --------------------------------------------------------------
DB_NAME=
DB_USERNAME=
DB_PASS=
# Porta do host exposta (mapeada no compose.yaml como "${DB_HOST}:5432")
DB_HOST=5432

# --------------------------------------------------------------
# CONEXÃO PRISMA / BACKEND
# --------------------------------------------------------------
# Formato: postgresql://[user]:[password]@[host]:[port]/[dbname]?schema=public
DATABASE_URL=

# --------------------------------------------------------------
# BACKEND (FASTIFY / NODE)
# --------------------------------------------------------------
PORT=3337
HOST=0.0.0.0

# Autenticação JWT (utilizado no auth.plugin.ts)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# CORS - Endereços permitidos do Frontend separados por vírgula
CORS_ORIGIN=http://localhost:5173

# --------------------------------------------------------------
# FRONTEND (VITE / NEXT.JS)
# --------------------------------------------------------------
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:3337
NEXT_PUBLIC_API_URL=http://localhost:3337
