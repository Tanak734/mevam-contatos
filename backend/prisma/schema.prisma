generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================
// ENUMS
// =============================================================

enum Genero {
  M
  F

  @@map("genero_tipo")
}

enum EstadoCivil {
  solteiro
  casado
  divorciado
  viuvo
  outro

  @@map("estado_civil_tipo")
}

enum StatusMembro {
  nao_membro
  membro

  @@map("status_membro_tipo")
}

enum StatusPessoa {
  novo_convertido
  afastado
  em_transicao
  outra_igreja
  lideranca_outra_igreja
  uber

  @@map("status_pessoa_tipo")
}

enum ComoConheceu {
  amigo
  familia
  convite_pessoa
  redes_sociais
  youtube
  oracao_12h
  google_maps
  passando_proximo
  connect
  acao_social
  evento
  outro

  @@map("como_conheceu_tipo")
}

enum TipoUsuario {
  usuario_externo
  voluntario_acolhimento
  lider_connect
  supervisor
  presbitero
  pastor
  admin

  @@map("tipo_usuario_tipo")
}

enum Residencia {
  casa
  apartamento
  condominio

  @@map("residencia_tipo")
}


// =============================================================
// MODELOS
// =============================================================

// 1. USUÁRIOS
model User {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome        String      @db.VarChar(100)
  telefone    String      @unique @db.VarChar(20)
  senhaHash   String      @map("senha_hash") @db.VarChar(255)
  genero      Genero?
  tipoUsuario TipoUsuario @default(usuario_externo) @map("tipo_usuario")
  isAdmin     Boolean     @default(false) @map("is_admin")
  isAtivo     Boolean     @default(true) @map("is_ativo")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime?   @map("deleted_at") @db.Timestamptz

  // Relações
  visitantesCadastrados   Visitante[]           @relation("ResponsavelCadastro")
  visitantesDiscipulados  Visitante[]           @relation("DiscipuladorDoVisitante") // NOVO: Quem ele discipula
  contatosRealizados      HistoricoContato[]    // Histórico de conversas feitas por ele
  acompanhamentos         AcompanhamentoAtivo[] // Visitantes que ele está acompanhando
  connectsLiderados       ConnectLider[]        // Connects onde ele é um dos líderes
  connectsSupervisionados Connect[]             @relation("SupervisorDoConnect") // Connects que ele supervisiona

  @@map("usuarios")
}

// 2. CONNECTS (Células)
model Connect {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome            String         @unique @db.VarChar(100)
  lideres         String?        @db.VarChar(100) // Texto de exibição rápido (ex: "Marcos e Ana")
  supervisorId    String?        @map("supervisor_id") @db.Uuid // Presbítero ou Supervisor responsável

  // Link fixo do local no Google Maps (pin exato). Se vazio, o front gera pelo endereço.
  linkMaps        String?        @map("link_maps") @db.VarChar(500)

  // Endereço Fixo (por bairro / geografia)
  tipoResidencia  Residencia     @default(casa) @map("tipo_residencia")
  rua             String         @db.VarChar(100)
  numero          String         @db.VarChar(10)
  bairro          String         @db.VarChar(100)
  cidade          String         @default("Campinas") @db.VarChar(100)
  complemento     String?        @db.Text
  cep             String?        @db.VarChar(9)

  isAtivo         Boolean        @default(true) @map("is_ativo")
  deletedAt       DateTime?      @map("deleted_at") @db.Timestamptz
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  // Relações
  supervisor      User?          @relation("SupervisorDoConnect", fields: [supervisorId], references: [id], onDelete: SetNull)
  lideresVinculo  ConnectLider[]
  visitantes      Visitante[]

  @@index([bairro], map: "idx_connects_bairro")
  @@map("connects")
}

// 3. TABELA DE LÍDERES DO CONNECT
model ConnectLider {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  connectId String   @map("connect_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  connect   Connect  @relation(fields: [connectId], references: [id], onDelete: Cascade)
  usuario   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([connectId, userId], map: "idx_connect_lider_unico")
  @@map("connect_lideres")
}

// 4. VISITANTES
model Visitante {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String            @map("user_id") @db.Uuid
  connectId         String?           @map("connect_id") @db.Uuid
  discipuladorId    String?           @map("discipulador_id") @db.Uuid // NOVO: Quem discipula

  // Dados Pessoais e Reconhecimento Visual
  nome              String            @db.VarChar(100)
  apelidoReferencia String?           @map("apelido_referencia") @db.VarChar(120)
  telefone          String            @unique @db.VarChar(20)
  dataNascimento    DateTime?         @map("data_nascimento") @db.Date
  genero            Genero?
  estadoCivil       EstadoCivil       @default(solteiro) @map("estado_civil")

  // Localização
  cidadeMora        String            @default("Campinas") @map("cidade_mora") @db.VarChar(100)
  bairro            String?           @db.VarChar(255)

  // Status Institucional e Pastoral
  statusMembro      StatusMembro      @default(nao_membro) @map("status_membro")
  statusPessoa      StatusPessoa?     @map("status_pessoa")
  tempoMembro       DateTime?         @map("tempo_membresia") @db.Date

  // Origem e Observações
  comoConheceu      ComoConheceu      @map("como_conheceu")
  outroMeioConhecer String?           @map("outro_meio") @db.VarChar(150)
  ultimoContato     DateTime?         @map("ultimo_contato") @db.Date
  observacaoPessoa  String?           @map("observacao_pessoa") @db.Text

  // Soft Delete
  isAtivo           Boolean           @default(true) @map("is_ativo")
  deletedAt         DateTime?         @map("deleted_at") @db.Timestamptz

  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  // Relações
  responsavel       User                  @relation("ResponsavelCadastro", fields: [userId], references: [id], onDelete: Restrict)
  discipulador      User?                 @relation("DiscipuladorDoVisitante", fields: [discipuladorId], references: [id], onDelete: SetNull)
  connect           Connect?              @relation(fields: [connectId], references: [id], onDelete: SetNull)
  historicoContatos HistoricoContato[]
  acompanhantes     AcompanhamentoAtivo[]

  // Índices para ordenações e buscas instantâneas
  @@index([nome], map: "idx_visitantes_nome")
  @@index([createdAt], map: "idx_visitantes_created_at")
  @@index([ultimoContato], map: "idx_visitantes_ultimo_contato")
  @@index([userId], map: "idx_visitantes_user_id")
  @@index([discipuladorId], map: "idx_visitantes_discipulador_id")
  @@index([connectId], map: "idx_visitantes_connect_id")
  @@index([statusMembro], map: "idx_visitantes_status_membro")
  @@index([statusPessoa], map: "idx_visitantes_status_pessoa")
  @@index([bairro], map: "idx_visitantes_bairro")
  @@index([isAtivo], map: "idx_visitantes_is_ativo")
  @@map("visitantes")
}

// 5. HISTÓRICO DE CONTATOS
model HistoricoContato {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  visitanteId       String    @map("visitante_id") @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  dataContato       DateTime  @default(now()) @map("data_contato") @db.Date
  observacaoContato String?   @map("observacao_contato") @db.Text

  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz

  visitante         Visitante @relation(fields: [visitanteId], references: [id], onDelete: Cascade)
  autor             User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([visitanteId], map: "idx_historico_visitante_id")
  @@index([dataContato], map: "idx_historico_data_contato")
  @@map("historico_contatos")
}

// 6. ACOMPANHAMENTO ATIVO (Anti-colisão)
model AcompanhamentoAtivo {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  visitanteId String    @map("visitante_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  isAtivo     Boolean   @default(true) @map("is_ativo")
  iniciadoEm  DateTime  @default(now()) @map("iniciado_em") @db.Timestamptz
  encerradoEm DateTime? @map("encerrado_em") @db.Timestamptz

  visitante   Visitante @relation(fields: [visitanteId], references: [id], onDelete: Cascade)
  usuario     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([visitanteId, userId], map: "idx_acomp_visitante_user_unico")
  @@index([visitanteId], map: "idx_acomp_visitante")
  @@index([userId], map: "idx_acomp_user")
  @@index([isAtivo], map: "idx_acomp_ativo")
  @@map("acompanhamentos_ativos")
}
